# Environment Configuration for TruckTrust
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=TruckTrust

# MongoDB Connection (MongoDB Compass / Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/trucktrust

# Authentication Secrets
JWT_SECRET=trucktrust_secure_super_secret_jwt_key_2026_maharashtra_rural

# SMS & OTP Provider (Options: dev-console, fast2sms, msg91, twilio)
SMS_PROVIDER=dev-console
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Storage Provider (Options: local, cloudinary, s3)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Razorpay test mode)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=
